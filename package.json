{
  "name": "yongs-dining",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "clean": "rm -rf .next out",
    "dev": "next dev",
    "dev:clean": "npm run clean && next dev",
    "dev:nocache": "NEXT_DISABLE_WEBPACK_CACHE=1 next dev",
    "build": "next build",
    "deploy": "npm run build && git add out && git commit -m 'Deploy' && git subtree push --prefix out origin gh-pages",
    "start": "next start",
    "lint": "next lint"
  },
  "dependencies": {
    "@heroicons/react": "^2.1.1",
    "autoprefixer": "^10.4.19",
    "clsx": "^2.1.1",
    "framer-motion": "^12.19.1",
    "lottie-react": "^2.4.1",
    "lucide-react": "^0.523.0",
    "next": "^15.5.18",
    "postcss": "^8.5.14",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-icons": "^5.5.0",
    "react-slick": "^0.30.3",
    "slick-carousel": "^1.8.1",
    "swiper": "^12.1.4",
    "tailwindcss": "^3.4.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^1.4.1",
    "@types/node": "24.0.3",
    "@types/react": "18.2.64",
    "@types/react-dom": "18.2.17",
    "@types/swiper": "^5.4.3",
    "eslint": "8.57.0",
    "eslint-config-next": "^15.5.18",
    "typescript": "5.4.5"
  },
  "overrides": {
    "postcss": "$postcss"
  }
}
