{
  "name": "yongs-dining",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "clean": "rm -rf .next out",
    "dev": "next dev",
    "dev:clean": "npm run clean && next dev",
    "dev:nocache": "NEXT_DISABLE_WEBPACK_CACHE=1 next dev",
    "build": "next build",
    "build:static": "STATIC_EXPORT=1 next build",
    "deploy": "npm run deploy:github",
    "deploy:github": "npm run build:static && git add -f out && git commit -m 'Deploy' && git subtree push --prefix out origin gh-pages",
    "start": "next start",
    "lint": "next lint"
  },
  "dependencies": {
    "autoprefixer": "^10.4.19",
    "clsx": "^2.1.1",
    "lucide-react": "^0.523.0",
    "next": "^15.5.18",
    "postcss": "^8.5.14",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tailwindcss": "^3.4.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^1.4.1",
    "@types/node": "24.0.3",
    "@types/react": "18.2.64",
    "@types/react-dom": "18.2.17",
    "eslint": "8.57.0",
    "eslint-config-next": "^15.5.18",
    "typescript": "5.4.5"
  },
  "overrides": {
    "postcss": "$postcss"
  }
}
